# ---- Providers -------------------------------------------------------------
# Anthropic is the only key needed for real results. Everything else is optional:
# the gateway registers a provider only when its key is present, and every view
# renders whatever is available.
#
# Check what you actually have:  playground probe

ANTHROPIC_API_KEY=

# Optional: OpenAI (GPT models)
# OPENAI_API_KEY=

# Optional: OpenRouter — one key for GPT *and* open models (Llama / Qwen / Kimi).
# Cheapest path to a genuinely multi-provider comparison.
# OPENROUTER_API_KEY=

# ---- Playground ------------------------------------------------------------

# Register the offline mock provider. On by default so a clean clone runs with
# no key at all. Its output is synthetic — the CLI and UI label it as such.
PLAYGROUND_ALLOW_MOCK=1

# Where per-request usage, latency, and cost are recorded.
PLAYGROUND_STORE=./data/playground.db

# Default benchmark repeats. Latency is reported as a percentile over these;
# lowering it below 3 makes the numbers noise.
PLAYGROUND_REPEATS=5

# Mirror benchmark runs into MLflow. Needs: pip install -e ".[tracking]"
PLAYGROUND_MLFLOW=0
PLAYGROUND_MLFLOW_EXPERIMENT=llm-playground

# ---- Defaults --------------------------------------------------------------

AI_CORE_DEFAULT_MODEL=claude-opus-5
AI_CORE_DEFAULT_EFFORT=medium
